{
  "name": "@graphile-contrib/view-constraints",
  "version": "0.1.0",
  "description": "Derive PostGraphile view constraints from PostgreSQL plans and catalogs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "rm -Rf dist && yarn build",
    "lint:fix": "prettier --ignore-path .gitignore --write '**/*.{js,jsx,ts,tsx,graphql,md,json}'",
    "prettier:check": "prettier --ignore-path .gitignore --check '**/*.{js,jsx,ts,tsx,graphql,md,json}'",
    "test": "node --test __tests__/PgViewConstraintsPlugin.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graphile-contrib/view-constraints.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/graphile-contrib/view-constraints/issues"
  },
  "devDependencies": {
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.10.2",
    "postgraphile": "^5.1.4",
    "prettier": "^3.9.6",
    "typescript": "^5.5.4"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "trailingComma": "none",
    "printWidth": 100
  },
  "packageManager": "yarn@4.18.0"
}
